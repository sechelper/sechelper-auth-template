# Deployment-only secrets and infrastructure connection URLs.
# The real .env file is ignored and must never be committed.
DATABASE_URL=postgres://app:change-me@127.0.0.1:5432/auth_template_test?sslmode=disable
REDIS_URL=redis://:change-me@127.0.0.1:26379/0
CONFIG_CENTER_ENCRYPTION_KEY=replace-with-43-character-base64-key
CONFIG_CENTER_INSTALL_KEY=replace-with-a-one-time-install-key
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=auth_template_test
REDIS_PASSWORD=change-me