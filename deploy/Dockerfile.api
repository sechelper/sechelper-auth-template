FROM golang:1.26.8 AS build
WORKDIR /src
COPY api/go.mod api/go.sum* ./api/
RUN cd api && go mod download
COPY api ./api
RUN cd api && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/auth-template ./cmd/server
RUN cd api && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/auth-template-migrate ./cmd/migrate

FROM gcr.io/distroless/base-debian12
COPY --from=build /out/auth-template /app/auth-template
COPY --from=build /out/auth-template-migrate /app/auth-template-migrate
COPY api/migrations /app/migrations
USER nonroot:nonroot
WORKDIR /app
ENTRYPOINT ["/app/auth-template"]
