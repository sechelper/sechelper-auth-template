# Compose interpolation and explicitly passed container environment only.
# The Go service reads config.yaml; it never treats this file as YAML.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=auth_template

# Application overrides/secrets passed explicitly to the API container.
APP_ENV=development
APP_VERSION=dev
LISTEN_ADDR=0.0.0.0:8080
DATABASE_PASSWORD=change-me
IDENTITY_CLIENT_ID=replace-me
IDENTITY_CLIENT_SECRET=replace-me
IDENTITY_APPLICATION_CODE=replace-me
IDENTITY_JWKS_URL=https://identity.example.com/.well-known/jwks.json
SESSION_ENCRYPTION_KEY=replace-with-43-character-base64-key
