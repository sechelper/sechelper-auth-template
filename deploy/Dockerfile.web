FROM node:24.21.0-alpine AS build
ARG BUILD_ENV=production
ARG NPM_VERSION=11.19.1
ARG RELEASE_VERSION
ARG BUILD_ID
ARG SOURCE_REVISION
ARG CANONICAL_BUILD
RUN test "$CANONICAL_BUILD" = 1 || { echo 'build images through the canonical make build entry point' >&2; exit 2; }
RUN test "$(node --version)" = "v24.21.0" \
 && npm install --global "npm@$NPM_VERSION" --no-audit --no-fund \
 && test "$(npm --version)" = "$NPM_VERSION"
RUN BUILD_PROFILE="$(printf '%s' "$BUILD_ENV" | tr '[:upper:]' '[:lower:]')" \
 && case "$BUILD_PROFILE" in development|test|production) ;; *) echo "unsupported BUILD_ENV: $BUILD_ENV" >&2; exit 2 ;; esac \
 && printf '%s\n' "$RELEASE_VERSION" | grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$' \
 && if [ "$BUILD_PROFILE" = development ]; then test "$BUILD_ID" = dev-local || printf '%s' "$BUILD_ID" | grep -Eq '^[0-9]{14}$'; else printf '%s' "$BUILD_ID" | grep -Eq '^[0-9]{14}$' && printf '%s' "$SOURCE_REVISION" | grep -Eq '^[0-9a-f]{40}$'; fi
WORKDIR /src/web
COPY web/package*.json ./
RUN npm ci
COPY web .
RUN npm run build -- --mode "$(printf '%s' "$BUILD_ENV" | tr '[:upper:]' '[:lower:]')" \
 && printf '{"component":"web","applicationVersion":"%s","buildId":"%s","sourceRevision":"%s","environment":"%s"}\n' "$RELEASE_VERSION" "$BUILD_ID" "$SOURCE_REVISION" "$BUILD_ENV" > dist/build-info.json

WORKDIR /src/web/admin
COPY web/admin/package*.json ./
RUN npm ci
COPY web/admin .
RUN npm run build -- --mode "$(printf '%s' "$BUILD_ENV" | tr '[:upper:]' '[:lower:]')" \
 && printf '{"component":"admin","applicationVersion":"%s","buildId":"%s","sourceRevision":"%s","environment":"%s"}\n' "$RELEASE_VERSION" "$BUILD_ID" "$SOURCE_REVISION" "$BUILD_ENV" > dist/build-info.json
RUN BUILD_PROFILE="$(printf '%s' "$BUILD_ENV" | tr '[:upper:]' '[:lower:]')"; \
    if [ "$BUILD_PROFILE" = production ]; then \
      if grep -R -E -q '/admin/(component-reference|orders)' /src/web/admin/dist; then echo 'test/example route leaked into production bundle' >&2; exit 1; fi; \
    elif [ "$BUILD_PROFILE" = test ]; then \
      grep -R -F -q '/admin/component-reference' /src/web/admin/dist || { echo 'test build is missing component reference route' >&2; exit 1; }; \
    elif grep -R -F -q '/admin/component-reference' /src/web/admin/dist; then echo 'test-only component reference leaked into development bundle' >&2; exit 1; fi; \
    if [ "$BUILD_PROFILE" != production ]; then \
      grep -R -F -q '/admin/orders' /src/web/admin/dist || { echo "$BUILD_PROFILE build is missing orders example route" >&2; exit 1; }; \
    fi

FROM nginx:1.27-alpine
ARG RELEASE_VERSION
ARG BUILD_ID
ARG SOURCE_REVISION
ARG BUILD_ENV=production
LABEL org.opencontainers.image.version="$RELEASE_VERSION" \
      org.opencontainers.image.revision="$SOURCE_REVISION" \
      io.sechelper.application.build-id="$BUILD_ID" \
      io.sechelper.application.environment="$BUILD_ENV"
COPY --from=build /src/web/dist /usr/share/nginx/html
COPY --from=build /src/web/admin/dist /usr/share/nginx/html/admin
